// 第 1 章 1.8 模块 —— 模块接口单元（interface unit）
// 文件名不重要，扩展名是约定：clang 用 .cppm，MSVC 用 .ixx，g++ 都接受
// 编译方法见 module_test.cpp 开头

// ------------------------------------------------------------
// 1. 全局模块片段：从 module; 开始，到 export module 为止，这里只能写预处理指令
//    用途：引入“必须靠 #include 才能拿到”的东西，最典型的就是宏（assert 是宏）
// ------------------------------------------------------------
module;
#include <cassert>

// ------------------------------------------------------------
// 2. 模块声明：从这一行开始是模块的正文（purview）
// ------------------------------------------------------------
export module bw_math;

// 模块里也可以 import 别的模块。没写 export，所以使用者 import bw_math 并不会顺带拿到 std
import std;

// 模块里定义的宏只在这个文件里有效，不会泄漏给 import 的人（头文件做不到这一点）
#define BW_SECRET 42

namespace bw
{
    // ------------------------------------------------------------
    // 3. 没有 export：只在模块内部可用，使用者看不到
    //    以前在头文件里只能靠 namespace detail 之类的约定“请别用”，现在编译器帮你挡住
    // ------------------------------------------------------------
    int secret()
    {
        return BW_SECRET;
    }

    // ------------------------------------------------------------
    // 4. export 单个声明
    // ------------------------------------------------------------
    export template <typename T>
    T add(T lhs, T rhs)
    {
        return lhs + rhs;
    }

    // ------------------------------------------------------------
    // 5. export 一个块：块里的所有声明都导出
    // ------------------------------------------------------------
    export
    {
        double safe_sqrt(double x)
        {
            assert(x >= 0); // 全局模块片段里 #include 的宏，在模块内部可以用
            return std::sqrt(x);
        }

        int answer()
        {
            return secret(); // 导出的函数可以调用没导出的函数
        }

        struct Point
        {
            int x;
            int y;
        };
    }

    // ------------------------------------------------------------
    // 6. 只导出声明，定义放在实现单元 bw_math_impl.cpp 里
    //    改实现文件时，接口没变，import 这个模块的文件不需要重新编译
    // ------------------------------------------------------------
    export double average(const std::vector<double>& v);
}

// ------------------------------------------------------------
// 7. 模块名和命名空间没有关系：hello 在全局命名空间，
//    使用者直接写 hello()，不是 bw_math::hello()，也不是 bw::hello()
// ------------------------------------------------------------
export void hello()
{
    std::println("hello from bw_math");
}
